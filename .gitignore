# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local

# vercel
.vercel

# python venv
.venv/

# codegraph index
.codegraph/

# n8n workflows con credenciales embebidas (n8n Cloud); el original sin secretos sí se versiona
n8n-workflows/*.cloud.json

# typescript
*.tsbuildinfo
next-env.d.ts
