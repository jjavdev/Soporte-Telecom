{
  "name": "Chatbot Nivel 1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatbot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.body.message?.toLowerCase() }}",
              "rightValue": "hola|hello|buenos|buenas|hey",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-greeting",
      "name": "Is Greeting",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: 'Hola! Bienvenido al soporte de Telecom. ¿En qué puedo ayudarte? Puedo ayudarte con: 1) Estado de tu ticket 2) Crear un nuevo ticket 3) Consultas frecuentes', intent: 'greeting' }) }}",
        "options": {}
      },
      "id": "respond-greeting",
      "name": "Greeting Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [690, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-2",
              "leftValue": "={{ $json.body.message?.toLowerCase() }}",
              "rightValue": "ticket|problema|falla|no funciona|ayuda|soporte",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "if-ticket",
      "name": "Is Ticket Request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: 'Entiendo que necesitas ayuda con un problema. Para crear un ticket, por favor ve a la sección de Tickets en el menú y haz clic en \"Nuevo Ticket\". Describe tu problema con detalle y te asignaremos un agente lo antes posible.', intent: 'create_ticket', action: 'redirect_tickets' }) }}",
        "options": {}
      },
      "id": "respond-ticket",
      "name": "Ticket Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [690, 350]
    },
    {
