        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: 'No estoy seguro de entender tu consulta. Puedo ayudarte con:\\n- Estado de tickets\\n- Crear nuevos tickets\\n- Información de servicios\\n\\n¿Podrías reformular tu pregunta?', intent: 'unknown' }) }}",
        "options": {}
      },
      "id": "respond-default",
      "name": "Default Reply",
      "type": "n8n-nodes-base.respondToWebhook",
