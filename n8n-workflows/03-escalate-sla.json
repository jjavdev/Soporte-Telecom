{
  "name": "Escalamiento SLA",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://bqqnuiisycaplcajapwx.supabase.co/rest/v1/tickets?status=eq.open&created_at=lt.{{ new Date(Date.now() - 2 * 60 * 60 * 1000).toISOString() }}&select=id,title,priority,created_at,client:users!tickets_client_id_fkey(email,full_name)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Get Overdue Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "Has Overdue",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://bqqnuiisycaplcajapwx.supabase.co/rest/v1/users?role=eq.admin&select=email,full_name&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-2",
      "name": "Get Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $json[0]?.email }}",
        "subject": "={{ $json.length + ' tickets sin agente por más de 2 horas' }}",
        "emailType": "html",
        "message": "<h2>Alerta SLA - Tickets Pendientes</h2><p>Hay {{ $json.length }} ticket(s) abiertos sin agente asignado por más de 2 horas:</p><ul>{{ $json.allItems.map(t => '<li><strong>' + t.title + '</strong> - Prioridad: ' + t.priority + ' - Cliente: ' + t.client?.full_name + '</li>').join('') }}</ul><p>Por favor, asigna agentes a estos tickets urgente.</p>",
        "options": {}
      },
      "id": "email-1",
      "name": "Alert Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1130, 200],
      "credentials": {
        "smtp": {
          "id": "smtp-credentials",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, overdue: $json.length } }}",
        "options": {}
      },
      "id": "respond-1",
      "name": "Done",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, overdue: 0 } }}",
        "options": {}
      },
      "id": "respond-2",
      "name": "No Overdue",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [910, 420]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Overdue Tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Overdue Tickets": {
      "main": [
        [
          {
            "node": "Has Overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Overdue": {
      "main": [
        [
          {
            "node": "Get Admin",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Admin": {
      "main": [
        [
          {
            "node": "Alert Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Admin": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "soporte-telecom"
    }
  ]
}
