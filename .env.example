NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_KEY=tu-service-key-aqui

# Chatbot (IA) — se usa desde el API route /api/chatbot (server-side)
CHATBOT_API_KEY=tu-api-key-aqui
CHATBOT_MODEL=deepseek-chat
# UUID del usuario "bot" en public.users (emisor de las respuestas del chatbot)
CHATBOT_USER_ID=00000000-0000-0000-0000-000000000000
# Opcional: endpoint OpenAI-compatible (por defecto DeepSeek)
# CHATBOT_API_URL=https://api.deepseek.com/chat/completions

# Opcional: solo si usas el workflow de n8n en lugar del API route
# NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678
